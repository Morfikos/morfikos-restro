DATABASE_URL=postgresql://user:password@host/db?sslmode=require
API_PORT=3000
# At least 32 characters. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Signs refresh/device cookies. At least 32 characters (must be different from JWT_SECRET).
COOKIE_SECRET=
# Comma-separated origins allowed to call the API from a browser (owner, cashier, waiter, kitchen, guest apps).
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005
# Public URL of the customer QR app.
GUEST_APP_URL=http://localhost:3005
# Free Google Gemini key for photo → floor map import. Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Defaults to gemini-flash-latest (always Google's current Flash model).
GEMINI_MODEL=
# Optional. Where uploaded images are stored. Defaults to apps/api/uploads.
UPLOADS_DIR=
