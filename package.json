{
  "name": "morfikos-restro",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@morfikos/web --filter=@morfikos/api",
    "dev:frontend": "turbo run dev --filter=@morfikos/web",
    "dev:backend": "turbo run dev --filter=@morfikos/api",
    "dev:api": "turbo run dev --filter=@morfikos/api",
    "build": "turbo run build",
    "postinstall": "pnpm --filter @morfikos/database generate"
  },
  "devDependencies": {
    "turbo": "^2.6.1",
    "typescript": "^5.9.3"
  }
}
