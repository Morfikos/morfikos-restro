generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id           String   @id @default(uuid())
  name         String
  gstin        String   @unique
  state        String
  city         String
  businessType String
  phone        String
  email        String   @unique
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  branches     Branch[]
  staff        Staff[]
}

model Branch {
  id                String       @id @default(uuid())
  name              String
  tables            Int
  organizationId    String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  address           String
  businessDays      Json
  code              String?
  gstin             String
  invoiceFy         String
  invoiceLastNumber Int          @default(0)
  phone             String
  settings          Json?
  status            String       @default("active")
  timezone          String
  city              String
  state             String
  fssaiNo           String?
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, status])
}

model Staff {
  id             String       @id @default(uuid())
  name           String
  email          String       @unique
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}
