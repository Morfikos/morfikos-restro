generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum UserRole {
  admin
  owner
  manager
  waiter
  staff
}
model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  passwordHash  String
  status        String         @default("active")
  lastLoginAt   DateTime?
  refreshTokens RefreshToken[]
  role UserRole @default(staff)
  memberships Membership[]
  passwordResetTokens PasswordResetToken[]
  ordersCreated       Order[]     @relation("OrderCreatedBy")
  ordersCancelled     Order[]     @relation("OrderCancelledBy")
  orderItemsVoided    OrderItem[] @relation("OrderItemVoidedBy")
  kotsCreated         Kot[]       @relation("KotCreatedBy")
  paymentsReceived    Payment[]   @relation("PaymentReceivedBy")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Organization {
  id           String   @id @default(uuid())
  name         String
  gstin        String   @unique
  state        String
  city         String
  businessType String
  phone        String
  email        String   @unique
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  branches     Branch[]
  staff        Staff[]
  memberships Membership[]
  menuCategories MenuCategory[]
  cuisines       Cuisine[]
  menuItems      MenuItem[]
  orders         Order[]
  }

model Branch {
  id                String    @id @default(uuid())
  name              String
  tables            Int
  organizationId    String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  address           String
  businessDays      Json
  code              String?
  gstin             String
  invoiceFy         String
  invoiceLastNumber Int       @default(0)
  phone             String
  settings          Json?
  status            String    @default("active")
  timezone          String
  city              String
  state             String
  membershipBranchRoles MembershipBranchRole[]
  fssaiNo            String?
  googleReviewUrl    String?
  businessDayCutoff  DateTime?
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceSequences InvoiceSequence[]
  menuItems        BranchMenuItem[]
  diningTables     DiningTable[]
  orders           Order[]
  kots             Kot[]
  counters         BranchCounter[]
  @@index([organizationId])
  @@index([organizationId, status])
}

model InvoiceSequence {
  id            String   @id @default(uuid())
  branchId      String
  financialYear String
  lastNumber    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  @@unique([branchId, financialYear])
  @@index([branchId])
}

model Staff {
  id             String   @id @default(uuid())
  name           String
  email          String   @unique
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Membership {
  id                  String   @id @default(uuid())
  organizationId      String
  userId              String
  status              String   @default("active")
  discountCeilingPct  Float?
  pinHash             String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchRoles  MembershipBranchRole[]
  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, status])
}

model Role {
  id          String   @id @default(uuid())
  organizationId String?
  name        String
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  permissions RolePermission[]
  branchRoles MembershipBranchRole[]
  @@index([organizationId])
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId         String
  permissionCode String
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)
  @@id([roleId, permissionCode])
  @@index([permissionCode])
}

model MembershipBranchRole {
  id           String   @id @default(uuid())
  membershipId String
  branchId     String?
  roleId       String
  createdAt    DateTime @default(now())
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  branch     Branch?    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@index([membershipId])
  @@index([branchId])
  @@index([roleId])
}

model MenuCategory {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        MenuItem[]
  @@unique([organizationId, name])
  @@index([organizationId, isActive])
}

model Cuisine {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@unique([organizationId, name])
  @@index([organizationId, isActive])
}

model MenuItem {
  id              String   @id @default(uuid())
  organizationId  String
  categoryId      String
  name            String
  description     String?
  gst             Decimal  @db.Decimal(5, 2)
  hsn             String
  isVeg           Boolean
  allergens       String[] @default([])
  preparationTime Int?
  imageUrl        String?
  isJain          Boolean  @default(false)
  isRecommended   Boolean  @default(false)
  sortOrder       Int      @default(0)
  kitchenStation  String   @default("hot_kitchen")
  timingEnabled      Boolean  @default(false)
  availableDays      String[] @default(["mon", "tue", "wed", "thu", "fri", "sat", "sun"])
  availableTimeStart String?
  availableTimeEnd   String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category        MenuCategory     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  branchItems     BranchMenuItem[]
  variants        MenuItemVariant[]
  addons          MenuItemAddon[]
  orderItems      OrderItem[]
  @@unique([categoryId, name])
  @@index([organizationId, isActive])
}

model MenuItemVariant {
  id                String   @id @default(uuid())
  menuItemId        String
  name              String
  extraPrice        Decimal  @default(0) @db.Decimal(10, 2)
  sortOrder         Int      @default(0)
  dineInAvailable   Boolean  @default(true)
  parcelAvailable   Boolean  @default(true)
  deliveryAvailable Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  menuItem          MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  @@unique([menuItemId, name])
}

model MenuItemAddon {
  id         String   @id @default(uuid())
  menuItemId String
  name       String
  price      Decimal  @db.Decimal(10, 2)
  isVeg      Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  @@unique([menuItemId, name])
}

model BranchMenuItem {
  id                  String   @id @default(uuid())
  branchId            String
  menuItemId          String
  price               Decimal  @db.Decimal(10, 2)
  costPrice           Decimal? @db.Decimal(10, 2)
  comparePrice        Decimal? @db.Decimal(10, 2)
  isAvailable         Boolean  @default(true)
  dineInAvailable     Boolean  @default(true)
  parcelAvailable     Boolean  @default(true)
  deliveryAvailable   Boolean  @default(true)
  maxQuantityPerOrder Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  branch              Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  menuItem            MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  @@unique([branchId, menuItemId])
  @@index([menuItemId])
}

model DiningTable {
  id        String   @id @default(uuid())
  branchId  String
  name      String
  qrCode    String   @unique @default(uuid())
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  orders    Order[]
  @@unique([branchId, name])
  @@index([branchId])
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderSource {
  POS
  QR
}

enum OrderStatus {
  OPEN
  BILLED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum PaymentMethod {
  CASH
  UPI
  CARD
}

enum OrderItemStatus {
  PENDING
  SENT
  VOID
}

enum KotStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}

model Order {
  id             String        @id @default(uuid())
  organizationId String
  branchId       String
  orderNumber    String
  businessDate   String
  orderType      OrderType     @default(DINE_IN)
  source         OrderSource   @default(POS)
  status         OrderStatus   @default(OPEN)
  paymentStatus  PaymentStatus @default(UNPAID)
  tableId        String?
  customerName   String?
  customerPhone  String?
  note           String?
  subtotal       Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(12, 2)
  roundOff       Decimal       @default(0) @db.Decimal(6, 2)
  totalAmount    Decimal       @default(0) @db.Decimal(12, 2)
  amountPaid     Decimal       @default(0) @db.Decimal(12, 2)
  invoiceNumber  String?
  financialYear  String?
  createdById    String
  billedAt       DateTime?
  paidAt         DateTime?
  cancelledAt    DateTime?
  cancelledById  String?
  cancelReason   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  table          DiningTable?  @relation(fields: [tableId], references: [id], onDelete: SetNull)
  createdBy      User          @relation("OrderCreatedBy", fields: [createdById], references: [id])
  cancelledBy    User?         @relation("OrderCancelledBy", fields: [cancelledById], references: [id])
  items          OrderItem[]
  kots           Kot[]
  payments       Payment[]
  @@unique([branchId, orderNumber])
  @@unique([branchId, invoiceNumber])
  @@index([branchId, status])
  @@index([branchId, businessDate])
  @@index([tableId, status])
}

model OrderItem {
  id             String          @id @default(uuid())
  orderId        String
  lineNumber     Int
  menuItemId     String?
  variantId      String?
  name           String
  variantName    String?
  isCustom       Boolean         @default(false)
  unitPrice      Decimal         @db.Decimal(10, 2)
  addons         Json            @default("[]")
  addonsPrice    Decimal         @default(0) @db.Decimal(10, 2)
  quantity       Int
  lineSubtotal   Decimal         @db.Decimal(12, 2)
  discountAmount Decimal         @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal         @default(0) @db.Decimal(12, 2)
  gstRate        Decimal         @db.Decimal(5, 2)
  hsn            String?
  kitchenStation String?
  note           String?
  status         OrderItemStatus @default(PENDING)
  kotId          String?
  voidedAt       DateTime?
  voidedById     String?
  voidReason     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem       MenuItem?       @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  kot            Kot?            @relation(fields: [kotId], references: [id], onDelete: SetNull)
  voidedBy       User?           @relation("OrderItemVoidedBy", fields: [voidedById], references: [id])
  @@unique([orderId, lineNumber])
  @@index([kotId])
  @@index([menuItemId])
}

model Kot {
  id           String      @id @default(uuid())
  orderId      String
  branchId     String
  kotNumber    Int
  businessDate String
  status       KotStatus   @default(PENDING)
  createdById  String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  order        Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  branch       Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdBy    User        @relation("KotCreatedBy", fields: [createdById], references: [id])
  items        OrderItem[]
  @@unique([branchId, businessDate, kotNumber])
  @@index([orderId])
}

model Payment {
  id             String        @id @default(uuid())
  orderId        String
  method         PaymentMethod
  amount         Decimal       @db.Decimal(12, 2)
  tenderedAmount Decimal?      @db.Decimal(12, 2)
  reference      String?
  receivedById   String
  createdAt      DateTime      @default(now())
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  receivedBy     User          @relation("PaymentReceivedBy", fields: [receivedById], references: [id])
  @@index([orderId])
}

model BranchCounter {
  id        String   @id @default(uuid())
  branchId  String
  name      String
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  @@unique([branchId, name])
}
