generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum UserRole {
  admin
  owner
  manager
  waiter
  staff
}
model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  passwordHash  String
  status        String         @default("active")
  lastLoginAt   DateTime?
  refreshTokens RefreshToken[]
  role UserRole @default(staff)
  memberships Membership[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Organization {
  id           String   @id @default(uuid())
  name         String
  gstin        String   @unique
  state        String
  city         String
  businessType String
  phone        String
  email        String   @unique
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  branches     Branch[]
  staff        Staff[]
  memberships Membership[]
  menuCategories MenuCategory[]
  cuisines       Cuisine[]
  menuItems      MenuItem[]
  }

model Branch {
  id                String    @id @default(uuid())
  name              String
  tables            Int
  organizationId    String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  address           String
  businessDays      Json
  code              String?
  gstin             String
  invoiceFy         String
  invoiceLastNumber Int       @default(0)
  phone             String
  settings          Json?
  status            String    @default("active")
  timezone          String
  city              String
  state             String
  membershipBranchRoles MembershipBranchRole[]
  fssaiNo            String?
  googleReviewUrl    String?
  businessDayCutoff  DateTime?
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceSequences InvoiceSequence[]
  menuItems        BranchMenuItem[]
  diningTables     DiningTable[]
  @@index([organizationId])
  @@index([organizationId, status])
}

model InvoiceSequence {
  id            String   @id @default(uuid())
  branchId      String
  financialYear String
  lastNumber    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  @@unique([branchId, financialYear])
  @@index([branchId])
}

model Staff {
  id             String   @id @default(uuid())
  name           String
  email          String   @unique
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Membership {
  id                  String   @id @default(uuid())
  organizationId      String
  userId              String
  status              String   @default("active")
  discountCeilingPct  Float?
  pinHash             String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchRoles  MembershipBranchRole[]
  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, status])
}

model Role {
  id          String   @id @default(uuid())
  organizationId String?
  name        String
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  permissions RolePermission[]
  branchRoles MembershipBranchRole[]
  @@index([organizationId])
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId         String
  permissionCode String
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)
  @@id([roleId, permissionCode])
  @@index([permissionCode])
}

model MembershipBranchRole {
  id           String   @id @default(uuid())
  membershipId String
  branchId     String?
  roleId       String
  createdAt    DateTime @default(now())
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  branch     Branch?    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@index([membershipId])
  @@index([branchId])
  @@index([roleId])
}

model MenuCategory {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        MenuItem[]
  @@unique([organizationId, name])
  @@index([organizationId, isActive])
}

model Cuisine {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@unique([organizationId, name])
  @@index([organizationId, isActive])
}

model MenuItem {
  id              String   @id @default(uuid())
  organizationId  String
  categoryId      String
  name            String
  description     String?
  gst             Decimal  @db.Decimal(5, 2)
  hsn             String
  isVeg           Boolean
  allergens       String[] @default([])
  preparationTime Int?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category        MenuCategory     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  branchItems     BranchMenuItem[]
  @@unique([categoryId, name])
  @@index([organizationId, isActive])
}

model BranchMenuItem {
  id                  String   @id @default(uuid())
  branchId            String
  menuItemId          String
  price               Decimal  @db.Decimal(10, 2)
  costPrice           Decimal? @db.Decimal(10, 2)
  isAvailable         Boolean  @default(true)
  maxQuantityPerOrder Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  branch              Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  menuItem            MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  @@unique([branchId, menuItemId])
  @@index([menuItemId])
}

model DiningTable {
  id        String   @id @default(uuid())
  branchId  String
  name      String
  qrCode    String   @unique @default(uuid())
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  @@unique([branchId, name])
  @@index([branchId])
}
